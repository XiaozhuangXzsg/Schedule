<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.2.0 起「从教务系统导入课表」覆盖全国高校，目前收录 1358 所本科院校，
  其中 543 所的入口是 http 站点
  （不少是校园网内的裸 IP + 端口，例如 http://119.145.248.32:84/jwglxt/xtgl/login_slogin.html）。

  逐个列举域名既不可维护也不可靠：域名与 IP 会随学校调整而变，漏一个就是
  「网页无法打开 net::ERR_CLEARTEXT_NOT_PERMITTED」。既然这些页面只在内置 WebView 里加载，
  且都是学校自己的教务系统，这里整体放开明文流量。

  应用自身的网络请求（AI 助手走用户配置的 OpenAI 兼容接口）全部是 https，
  不受这条配置影响——它只是**允许**明文，并不会把 https 降级。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
